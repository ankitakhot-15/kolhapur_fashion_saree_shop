# =====================================================
# Kolhapuri Fashion Saree - environment variables
# Copy this file to ".env" and fill in your real values.
# NEVER put real keys in this file (.env.example is public).
# =====================================================

# ---------- Firebase (public web config, used in browser) ----------
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"

# ---------- Cloudinary (public, used in browser for image upload) ----------
# The upload preset must be set to "Unsigned" in the Cloudinary dashboard
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"
VITE_CLOUDINARY_UPLOAD_PRESET="your_unsigned_upload_preset"

# ---------- Razorpay (public key id, used in browser) ----------
# Must be the SAME key id as RAZORPAY_KEY_ID below
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# =====================================================
# SERVER-ONLY SECRETS (Firebase Functions / backend)
# Never prefix these with VITE_ and never add them to the
# Render static site, or they become visible to everyone.
# =====================================================

# ---------- Cloudinary (server) ----------
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ---------- Razorpay (server, test mode) ----------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# ---------- SMTP (Gmail, for OTP emails) ----------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your_email@gmail.com"
# Gmail app password: 16 characters, NO spaces
SMTP_PASS="your_gmail_app_password"